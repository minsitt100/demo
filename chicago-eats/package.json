{
  "name": "chicago-eats",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time feed of new restaurant openings in Chicago, aggregated from multiple sources.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node -e \"import('./scraper.js').then(m => m.runAllSources().then(n => { console.log('done:', n, 'new'); process.exit(0); }))\"",
    "seed:demo": "node scripts/seed-demo.js",
    "verify:urls": "node scripts/verify-urls.js",
    "peek:feed": "node scripts/peek-feed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  }
}
